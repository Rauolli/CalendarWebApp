<div class="day-card @(Day.IsHoliday ? "tooltip": "")" data-tooltip="@(Day.IsHoliday ? Day.HolidayName : null)">
    <button class="@GetCssClass()" @onclick="OnDayClick">
        @Day.Date.Day
    </button>
</div>

@code {
    [Parameter]
    public CalendarDay Day { get; set; } = default!;

    [Parameter] public EventCallback<CalendarDay> OnClick { get; set; }

    private string GetCssClass() => Day switch
    {
        { IsInCurrentMonth: false } => "not-current-month",
        { IsToday: true }           => "today",
        { IsWeekend: true }         => "weekend",
        { IsHoliday: true }         => "holiday",
        _                           => ""
    };

    private async Task OnDayClick() => await OnClick.InvokeAsync(Day);
}
